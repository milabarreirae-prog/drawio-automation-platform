# drawio-automation-platform — plantilla de configuración
# Copiar a .env y rellenar los valores:
#   cp .env.example .env

# ============================================================================
# LLM — clasificador C4 (--classifier llm / auto)
# Endpoint OpenAI-compatible. Dejar vacío para usar solo la heurística.
# ============================================================================
C4NORM_LLM_API_BASE=https://api.openai.com/v1
C4NORM_LLM_API_KEY=
# Modelo por defecto si no se especifica:
C4NORM_LLM_MODEL=gpt-4o-mini
# Ejemplos de proveedores alternativos:
#   Alibaba Cloud MaaS: https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
#     modelos: qwen3.7-max, qwen3.6-plus, qwen3.6-flash, deepseek-v4-pro, deepseek-v4-flash, ...
#   Azure OpenAI:   https://<resource>.openai.azure.com/openai/deployments/<deployment>
#   Anthropic (compatible): https://api.anthropic.com/v1

# ============================================================================
# Layout (opcional)
# ============================================================================
# Forzar motor de layout: elk | layered | auto (por defecto: auto)
# C4NORM_LAYOUT=auto
# Ruta al ejecutable de Node si no está en el PATH:
# C4NORM_NODE_BIN=

# ============================================================================
# API
# ============================================================================
# Clave para proteger los endpoints (dejar vacío = sin autenticación):
API_KEY=
# Orígenes CORS permitidos (coma-separados, * = todos):
CORS_ORIGINS=*
# Rate limiting por IP:
RATE_LIMIT_ENABLED=true
RATE_LIMIT_NORMALIZE_PER_MINUTE=60
# Tamaño máximo del payload XML (bytes):
MAX_XML_PAYLOAD_SIZE=10485760
# Nivel de log: debug | info | warning | error
LOG_LEVEL=info

# ============================================================================
# Compliance opcional
# ============================================================================
# Stencils permitidos (coma-separados); dejar vacío = sin restricción:
ALLOWED_STENCILS=aws4,gcp2,azure,archimate3,c4,cisco,oci
# Paleta de colores permitida (hex sin #, coma-separados); vacío = sin validación:
ALLOWED_COLORS=
# Clave de licencia ArchiMate (requerida para usar stencils ArchiMate):
ARCHIMATE_LICENSE_KEY=
