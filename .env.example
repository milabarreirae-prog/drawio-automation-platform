# ============================================================================
# drawio-automation-platform — Environment Configuration
# ============================================================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
# ============================================================================

# ============================================================================
# Redis Configuration
# ============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# Connection pool settings
REDIS_MAX_CONNECTIONS=20

# ============================================================================
# ARQ (Async Redis Queue) Configuration
# ============================================================================
# Redis URL for ARQ (built from REDIS_* vars if not set explicitly)
# ARQ_REDIS_URL=redis://redis:6379/0
# Health check interval for worker
ARQ_HEALTH_CHECK_INTERVAL=1
# Maximum concurrent jobs per worker
ARQ_MAX_JOBS=20
# Timeout for individual jobs (seconds)
ARQ_JOB_TIMEOUT=300
# Keep job results in Redis for this many seconds
ARQ_EXPIRES=3600

# ============================================================================
# S3/MinIO Storage Configuration
# ============================================================================
# For MinIO local (development):
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=drawio-exports

# For AWS S3 (production):
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
# S3_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# S3_BUCKET_NAME=your-drawio-exports-bucket
# S3_REGION=us-east-1

# Object prefix in bucket (optional, e.g., "exports/" or "diagrams/")
S3_KEY_PREFIX=

# Presigned URL expiration for generated exports (seconds)
S3_PRESIGNED_URL_EXPIRES=3600

# ============================================================================
# Export Configuration
# ============================================================================
# Default export format (svg, png, pdf)
DEFAULT_EXPORT_FORMAT=svg
# Allowed export formats (comma-separated)
ALLOWED_EXPORT_FORMATS=svg,png,pdf
# Default export scale (1.0 = 100%, 2.0 = 200%)
DEFAULT_EXPORT_SCALE=1.0

# ============================================================================
# Stencils Configuration
# ============================================================================
# Comma-separated list of allowed stencil libraries
ALLOWED_STENCILS=aws4,gcp2,azure,archimate3,c4,cisco,oci

# ============================================================================
# Corporate Compliance: Allowed Colors
# ============================================================================
# Comma-separated list of hex colors (without #) that are allowed in diagrams.
# Colors found in XML that are NOT in this list will be rejected.
# Example corporate palette:
ALLOWED_COLORS=1A1A1A,333333,4A90D9,50C878,2C3E50,ECF0F1,E74C3C,F39C12,3498DB,2ECC71

# Leave empty to disable color validation (ALL colors allowed):
# ALLOWED_COLORS=

# ============================================================================
# ArchiMate License Configuration
# ============================================================================
# ArchiMate is a registered trademark of The Open Group.
# Commercial use requires a license key.
# Obtain at: https://www.opengroup.org/certifications/archimate
# Leave empty to BLOCK all ArchiMate rendering:
ARCHIMATE_LICENSE_KEY=

# ============================================================================
# Worker Configuration
# ============================================================================
# Maximum concurrent rendering jobs per worker container
WORKER_MAX_JOBS=3
# Timeout for rendering jobs (seconds) - should be generous for large diagrams
WORKER_JOB_TIMEOUT=300
# Maximum render retries for transient failures (TIMEOUT, OOM, NODE_CRASH)
WORKER_RENDER_MAX_RETRIES=2
# Backoff factor for retries (multiplier for exponential backoff in seconds)
WORKER_RENDER_RETRY_BACKOFF=2

# ============================================================================
# Chromium/Draw.io Rendering Configuration
# ============================================================================
# Chromium flags passed to drawio-desktop (DO NOT modify unless necessary)
CHROMIUM_FLAGS=--no-sandbox,--disable-gpu,--disable-dev-shm-usage,--disable-setuid-sandbox,--single-process

# Draw.io CLI path inside worker container
DRAWIO_CLI_PATH=/opt/drawio/drawio

# ============================================================================
# Webhook Configuration
# ============================================================================
# Default webhook URL for task completion notifications
# Override per-request via webhook_url parameter in API call
WEBHOOK_DEFAULT_URL=
# Timeout for webhook HTTP requests (seconds)
WEBHOOK_TIMEOUT=30
# Maximum webhook delivery retries
WEBHOOK_MAX_RETRIES=2

# ============================================================================
# Logging Configuration
# ============================================================================
# Log level: debug, info, warning, error
LOG_LEVEL=info
# Log format: json or text
LOG_FORMAT=json
# Enable access log for API requests
ACCESS_LOG_ENABLED=true

# ============================================================================
# Security Configuration
# ============================================================================
# API key for securing endpoints (leave empty for no authentication)
API_KEY=
# Allowed CORS origins (comma-separated, * for all)
CORS_ORIGINS=*

# ============================================================================
# Resource Limits
# ============================================================================
# Maximum XML payload size in bytes (default: 10MB)
MAX_XML_PAYLOAD_SIZE=10485760