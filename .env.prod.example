# drawio-automation-platform — plantilla del perfil PRODUCCIÓN.
# Copiar a .env.prod (gitignored) y rellenar con valores REALES:
#   cp .env.prod.example .env.prod
#
# Regla HU-ARQ-D4: los valores reales viven SOLO aquí, jamás en el perfil dev.
# Si una variable queda vacía la API arranca con su default (clasificador
# heuristic-only para el LLM). API_KEY vacía = endpoints SIN autenticación:
# no desplegar así.

# ===== Seguridad (OBLIGATORIA en prod) =====
# Clave Bearer para proteger los endpoints. VACÍA = SIN autenticación.
API_KEY=

# ===== LLM — clasificador C4 (opcional; vacío = solo heurística) =====
C4NORM_LLM_API_BASE=https://api.openai.com/v1
C4NORM_LLM_API_KEY=
C4NORM_LLM_MODEL=gpt-4o-mini

# ===== API =====
CORS_ORIGINS=*
RATE_LIMIT_ENABLED=true
RATE_LIMIT_NORMALIZE_PER_MINUTE=60
MAX_XML_PAYLOAD_SIZE=10485760
LOG_LEVEL=info
